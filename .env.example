# ========================================
# SOBIS Premium - متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم
# ========================================

# PostgreSQL قاعدة البيانات (مطلوب)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# سر تشفير الجلسات - غيّره في الإنتاج إلى قيمة عشوائية طويلة! (مطلوب في الإنتاج)
SESSION_SECRET=change-me-to-a-long-random-secret

# البريد الإلكتروني (اختياري - بديل عن الإعدادات في قاعدة البيانات)
# يستحسن مع Gmail كلمات مرور التطبيقات App Password
EMAIL_USER=
EMAIL_APP_PASS=

# ملاحظات أمان
# لا ترفع ملف .env أبداً إلى أي مستودع عام
# لا تضع أي مفاتيح أو أسرار حقيقية في ملفات الواجهة (كل الأسرار تُقرأ في الخادم فقط)
